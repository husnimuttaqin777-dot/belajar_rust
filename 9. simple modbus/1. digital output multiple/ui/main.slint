export component MainWindow inherits Window {
    width: 400px;
    height: 400px;
    title: "membuat MINI SCADA HMI";
    background: #FF96C5;

    // dikirim ke Rust (setara backend.button1(...) di QML)
    callback button1(string);
    // setara button1.checked di QML (checkable : true)
    in-out property <bool> button1-checked: false;
    property <color> button1-color: #340040;


    callback button2(string);
    in-out property <bool> button2-checked: false;
    property <color> button2-color: #340040;

    callback button3(string);
    in-out property <bool> button3-checked : false;
    property <color> button3-color : #340040;

    // Button1
    Rectangle {
        x: 10px;
        y: 150px;
        width: 90px;
        height: 90px;
        background: root.button1-color;

        Text {
            x: 10px;
            y: 10px;
            text: "button1";
            font-size: 15px;
            color: black;
        }

        // tombol bisa diklik: toggle checked (setara checkable : true)
        TouchArea {
            clicked => {
                root.button1-checked = !root.button1-checked;

                if (root.button1-checked == true) {
                root.button1-color = #F2055C;
                root.button1("1");
                }

                if (root.button1-checked == false) {
                    root.button1-color = #340040;
                    root.button1("0");
                }
            }
        }
    }

    // Button2
    Rectangle {
        x: 110px;
        y: 150px;
        width: 90px;
        height: 90px;
        background: root.button2-color;

        Text {
            x: 10px;
            y: 10px;
            text: "button2";
            font-size: 15px;
            color: black;
        }

        // tombol bisa diklik: toggle checked (setara checkable : true)
        TouchArea {
            clicked => {
                root.button2-checked = !root.button2-checked;

                if (root.button2-checked == true){
                    root.button2-color = #F2055C;
                    root.button2("1"); 
                }

                if (root.button2-checked == false){
                    root.button2-color = #340040;
                    root.button2("0");
                }
            }
        }
    }

    Rectangle{
        x : 210px;
        y : 150px;
        width : 90px;
        height : 90px;
        background : root.button3-color;
        
        Text{
            x : 10px;
            y : 10px;
            text : "button3";
            font-size : 15px;
            color : black;
        }
        TouchArea{
            clicked=> {
                root.button3-checked = !root.button3-checked;
                if(root.button3-checked == true){
                    root.button3-color = #F2055C;
                    root.button3("1");
                }
                if (root.button3-checked == false){
                    root.button3-color = #340040;
                    root.button3("0");
                }
            }
        }
    } 

    // guitimer
    Timer {
        interval: 200ms;
        running: true;
        triggered => {
            

            

        }
    }
}
